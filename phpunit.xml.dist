<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests (issue #99). No schema reference, so that the file works with PHPUnit 9, 10 and 11. -->
<phpunit bootstrap="tests/unit/bootstrap.php" colors="true" cacheResult="false" failOnRisky="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
