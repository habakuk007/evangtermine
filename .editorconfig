root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress Coding Standards: tabs for indentation.
[*.{php,css,js,xml}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown: trailing spaces are line breaks.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Bundled third-party libraries: leave as they are.
[assets/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
