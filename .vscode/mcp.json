{
	"servers": {
		"playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": ["@playwright/mcp@latest"]
		},
		"markitdown": {
			"type": "stdio",
			"command": "uvx",
			"args": ["markitdown-mcp@0.0.1a4"]
		},
		"context7": {
			"type": "stdio",
			"command": "npx",
			"args": ["@upstash/context7-mcp@1.0.31"],
			"env": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			}
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp"
		},
		"microsoft-docs": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		}
	}
}

