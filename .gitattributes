# LF line endings for all text files in the repository
# (mirrors .editorconfig end_of_line = lf).
* text=auto eol=lf

# Binary files: never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.zip   binary
