{
	"mcpServers": {
		"playwright-mcp": {
			"command": "npx",
			"args": ["@playwright/mcp@latest"]
		},
		"markitdown": {
			"command": "uvx",
			"args": ["markitdown-mcp@0.0.1a4"]
		},
		"context7": {
			"command": "npx",
			"args": ["@upstash/context7-mcp@1.0.31"]
		},
		"github-mcp": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"microsoft-docs": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		}
	}
}
